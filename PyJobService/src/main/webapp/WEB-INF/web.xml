<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="jakarta.ee.xml.ns.jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="jakarta.ee.xml.ns.jakartaee 
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>PyJobService Web Service</display-name>

    <!-- 1. Define the CXF Servlet -->
    <servlet>
        <display-name>CXF JAX-WS Servlet</display-name>
        <servlet-name>CXFServlet</servlet-name>
        <servlet-class>org.apache.cxf.transport.servlet.CXFServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- 2. Map the Servlet to a URL pattern -->
    <servlet-mapping>
        <servlet-name>CXFServlet</servlet-name>
        <!-- All SOAP requests and WSDL requests will go through /services/* -->
        <url-pattern>/services/*</url-pattern>
    </servlet-mapping>

</web-app>
