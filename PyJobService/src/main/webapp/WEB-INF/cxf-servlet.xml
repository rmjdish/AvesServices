<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:jaxws="http://cxf.apache.org/jaxws"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans 
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://cxf.apache.org/jaxws 
           http://cxf.apache.org/schemas/jaxws.xsd">

    <!-- Import CXF's default bus configurations -->
    <import resource="classpath:META-INF/cxf/cxf.xml" />
    <import resource="classpath:META-INF/cxf/cxf-servlet.xml" />

    <!-- Publish your Web Service -->
    <!-- 
      IMPORTANT: Change 'ucl.service.zip.YourImplementingClass' to the exact 
      name of the Java class that holds your @WebService annotation 
      (e.g., ZIPService, Boomerang, or ZIPServiceServer).
    -->
    <jaxws:endpoint 
        id="zipServiceEndpoint" 
        implementor="ucl.service.zip.Boomerang" 
        address="/ZIPService" />

</beans>
