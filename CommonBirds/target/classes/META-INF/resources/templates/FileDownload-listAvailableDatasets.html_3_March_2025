{% extends swiftVersion|slice(0,6) == "Condor" ? "SKYLARK" : "SWIFT" %}
{% block results %}
<div class="results">
	{% include "oneverypage" %}
	<h2>{{ title }}</h2>
	{% if results is not empty %}
	<p>There are {{ numResults / numCols }} datasets built from baskets.</p>
	<p>
		If you see a downward arrow appearing in the <em>Download</em> column
		a dataset is available for download. Depending on your
		computer/browser, you can right click and use the save as option to
		save your dataset.  Alternatively, look for the zip archive file in your <em>Download</em> folder.
	</p>
	<p>
		If the you were expecting to see a downloaded file but it is not listed here, please attempt to 
		build the basket/trolley again.  If is still fails to show up after several minutes please report 
		the problem to the LHA via MRCLHA.SwiftInfo@ucl.ac.uk
	</p>
	<table>
		<tr>
			<th class="skip-filter" style="width: 10%;">Basket ID</th>
			<th style="width: 5%;">Status</b></th>
			<th class="skip-filter" style="width: 35%;">Description</th>
			<th style="width: 10%;">User Name</th>
			<th class="skip-filter" style="width: 20%;">Date Created</th>
			<th class="skip-filter" style="width: 10%;">Download?</th>
		</tr>

		{# There are 6 columns of data supplied #}
		{% for val in results %} 
		    {% if (loop.index + 1) % numCols equals 0 %}
			{# The last column of data: file name if present #} 
				{% if val | length > 10 %}
					<td><a href="{{ val }}" style="font-size:1.5em">&#x21AF;</a></td> 
				{% else %}
					<td style="color:red">{{ val | raw }}</td> 
				{% endif %}
			</tr>
			{% elseif (loop.index + 1) % numCols equals 1 %} 
				{# First column on the page is the Basket ID #}
				<tr>
				<td style="width: 10%"><a href="previousBasket?&id={{sessionID}}&basketID={{ val }}">{{ val }}</a></td> 
			{% else %} 
				{# this is used for the rest of the columns #}
				<td>{{ val }}</td> 
			{% endif %} {# end of if (loop.index...) #} 
		{% endfor %} {# end of for val in results #}
	</table>
	{% else %} {# results is empty #}
		<p>There are no external baskets.</p>
	{% endif %} {# end of if results is not empty #}
</div>
{% endblock results %}




