<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
  <display-name>Jay</display-name>
  <absolute-ordering></absolute-ordering>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <!-- Servlet Name/Class Bindings -->
  <servlet>
  	<servlet-name>reports</servlet-name>
  	<servlet-class>jay.core.Reports</servlet-class>
  </servlet>
  
  <servlet>
  	<servlet-name>previousBasket</servlet-name>
  	<servlet-class>mrc.wdap.user.PreviousBasket</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>filedownload</servlet-name>
  	<servlet-class>mrc.wdap.user.FileDownload</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>pyDBCheckout</servlet-name>
    <servlet-class>mrc.wdap.user.PyDBCheckout</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>scramble</servlet-name>
    <servlet-class>jay.core.Scramble</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>forms</servlet-name>
    <servlet-class>jay.core.Forms</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>projects</servlet-name>
    <servlet-class>jay.core.Projects</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>jaybaskets</servlet-name>
  	<servlet-class>jay.core.JayBasket</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>recoverPassword</servlet-name>
    <servlet-class>mrc.wdap.user.RecoverPassword</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>mrc.wdap.user.Login</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>logout</servlet-name>
    <servlet-class>mrc.wdap.user.Logout</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>register</servlet-name>
    <servlet-class>mrc.wdap.user.Register</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>search</servlet-name>
    <servlet-class>mrc.wdap.user.Search</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>changeRegistration</servlet-name>
    <servlet-class>mrc.wdap.user.ChangeRegistration</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>changePassword</servlet-name>
    <servlet-class>mrc.wdap.user.ChangePassword</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>resetPassword</servlet-name>
    <servlet-class>mrc.wdap.user.ResetPassword</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>approveUser</servlet-name>
    <servlet-class>mrc.wdap.user.ApproveUser</servlet-class>
  </servlet>
  <!--  Servlet/URL Mappings Below Here -->
  <servlet-mapping>
  	<servlet-name>reports</servlet-name>
  	<url-pattern>/reports</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>previousBasket</servlet-name>
  	<url-pattern>/previousBasket</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>filedownload</servlet-name>
  	<url-pattern>/filedownload</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>pyDBCheckout</servlet-name>
    <url-pattern>/pyDBCheckout</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>scramble</servlet-name>
    <url-pattern>/scramble</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>forms</servlet-name>
    <url-pattern>/forms</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>projects</servlet-name>
    <url-pattern>/projects</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>jaybaskets</servlet-name>
  	<url-pattern>/jaybaskets</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>approveUser</servlet-name>
    <url-pattern>/approveUser</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>logout</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>register</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>search</servlet-name>
    <url-pattern>/search</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>changeRegistration</servlet-name>
    <url-pattern>/changeRegistration</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>changePassword</servlet-name>
    <url-pattern>/changePassword</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>recoverPassword</servlet-name>
    <url-pattern>/recoverPassword</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>resetPassword</servlet-name>
    <url-pattern>/resetPassword</url-pattern>
  </servlet-mapping>
  <!--  Filters To Shutdown Session on Timeout -->
  <filter>
    <filter-name>sessionFilter</filter-name>
    <filter-class>mrc.util.SessionFilter</filter-class>
  </filter>
  <!--  Here are the Servlets to apply the filter to -->
  <filter-mapping>
    <filter-name>sessionFilter</filter-name>
    <servlet-name>reports</servlet-name>
    <servlet-name>previousBasket</servlet-name>
    <servlet-name>filedownload</servlet-name>
    <servlet-name>pyDBCheckout</servlet-name>
    <servlet-name>scramble</servlet-name>
	<servlet-name>projects</servlet-name>
    <servlet-name>forms</servlet-name>
    <servlet-name>jaybaskets</servlet-name>
    <servlet-name>register</servlet-name>
    <servlet-name>recoverPassword</servlet-name>
    <servlet-name>search</servlet-name>
    <servlet-name>changeRegistration</servlet-name>
    <servlet-name>changePassword</servlet-name>
    <servlet-name>resetPassword</servlet-name>
    <servlet-name>approveUser</servlet-name>
  </filter-mapping>
  <session-config>
    <session-timeout>60</session-timeout>
  </session-config>
</web-app>