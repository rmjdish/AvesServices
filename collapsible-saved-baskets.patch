--- a/CommonBirds/src/main/resources/web/css/owl.css
+++ b/CommonBirds/src/main/resources/web/css/owl.css
@@ -2125,3 +2125,93 @@
 .owl-linked-toggle-switch.owl-toggle-on .owl-linked-toggle-thumb {
     left: 20px;
 }
+
+
+/* ---- Save confirmation: collapsible saved baskets ----
+   Each saved basket is a <details> section (built by Basket.java's
+   buildBasketTableHtml()): the ID and variable count stay visible as
+   a one-line summary, the variable table opens on request. */
+.results details.owl-saved-basket {
+    max-width: 900px;
+    margin: 0 0 10px;
+    border: 1px solid #d4cbe6;
+    border-radius: 8px;
+    background: #fff;
+}
+
+.results details.owl-saved-basket > summary {
+    display: flex;
+    align-items: baseline;
+    gap: 12px;
+    padding: 10px 14px;
+    cursor: pointer;
+    list-style: none;
+    border-radius: 8px;
+}
+
+.results details.owl-saved-basket > summary::-webkit-details-marker {
+    display: none;
+}
+
+.results details.owl-saved-basket > summary::before {
+    content: "\25B8";
+    color: #6a0dad;
+    font-size: 14px;
+    transition: transform 0.15s;
+}
+
+.results details.owl-saved-basket[open] > summary::before {
+    transform: rotate(90deg);
+}
+
+.results details.owl-saved-basket > summary:hover {
+    background: #f5f2ff;
+}
+
+.results details.owl-saved-basket > summary:focus-visible {
+    outline: 3px solid #b48ad6;
+    outline-offset: 2px;
+}
+
+.results details.owl-saved-basket[open] > summary {
+    border-bottom: 1px solid #d4cbe6;
+    border-radius: 8px 8px 0 0;
+}
+
+.owl-saved-basket-id {
+    font-size: 15px;
+    font-weight: 600;
+    color: #3a0066;
+}
+
+.owl-saved-basket-count {
+    font-size: 13px;
+    color: #666;
+}
+
+.results details.owl-saved-basket table.owl-table {
+    margin: 12px auto 12px 14px;
+}
+
+.owl-saved-basket-toolbar {
+    margin: 0 0 12px;
+}
+
+.owl-saved-basket-btn {
+    font: inherit;
+    font-size: 13px;
+    padding: 5px 12px;
+    cursor: pointer;
+    color: #3a0066;
+    background: #fff;
+    border: 1px solid #c9b3dc;
+    border-radius: 6px;
+}
+
+.owl-saved-basket-btn:hover {
+    background: #f3e5f5;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .results details.owl-saved-basket > summary::before { transition: none; }
+}
